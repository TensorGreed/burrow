# --- Rust ---
/target/
**/target/
*.rs.bk
*.pdb

# --- cargo-fuzz ---
/fuzz/target/
/fuzz/corpus/
/fuzz/artifacts/
/fuzz/coverage/

# --- Node / pnpm ---
node_modules/
.pnpm-store/
*.tsbuildinfo
npm-debug.log*
pnpm-debug.log*

# --- Astro / web build output ---
apps/web/dist/
# Staged engine artifacts and the CSP generated from them. Derived from engines/vendor/
# (itself gitignored) and bindings/burrow-wasm/pkg/ by tools/stage-web-engines.mjs, and
# content-hashed, so committing them would mean committing a 6 MB binary that changes name
# on every engine bump.
apps/web/public/engines/
# The main-thread host, copied verbatim from apps/web/src/host/ by the same tool. The sources
# are tracked; this copy is build output.
apps/web/public/host/
apps/web/public/_headers
apps/web/src/generated/
apps/web/dist-production-check/
apps/web/dist-harness-check/
apps/web/test-results/
apps/web/playwright-report/
apps/web/.astro/
apps/web/.vercel/
apps/web/.netlify/

# --- WASM build output ---
bindings/burrow-wasm/pkg/

# --- Corpus: the manifest is tracked, the files are never committed ---
# Test corpora can be large and can contain third-party or sensitive documents.
# Fetch them with tools/corpus-fetch.sh using corpus/manifest.toml.
corpus/files/
corpus/cache/
corpus/out/

# --- Generated corpus output, anywhere in the tree ---
# Generated corpora are reproducible from their generator, so committing them is pure
# cost. Spike 0001 committed a 50 MB generated PDF by mistake because its own .gitignore
# lived only on the spike branch; these rules live on main so it cannot recur here.
**/common/corpus/
**/corpus/generated/
*.generated.pdf

# --- Spike artifacts (spikes/ is excluded from the cargo workspace) ---
# Spike code is throwaway and its inputs are all reproducible: pinned+checksummed
# downloads, deterministic generators, assembly scripts. Only sources belong in git.
spikes/**/vendor/
spikes/**/build/
spikes/**/pkg/
spikes/**/www/
spikes/**/node_modules/
spikes/**/target/
spikes/**/test-results/
spikes/**/playwright-report/
spikes/**/*.wasm
spikes/**/*.data

# --- Golden/regression run artifacts ---
/tools/out/
*.actual.pdf
*.actual.png
*.diff.png

# --- Vendored native engines (M1) ---
# Everything under engines/vendor/ is reproducible from engines/pins.toml via
# engines/fetch.sh (checksum-verified) plus the build scripts. Nothing there is
# committed: the artifacts are large, third-party, and byte-pinned elsewhere.
engines/vendor/

# --- Native engine build artifacts ---
/vendor/**/build/
/vendor/**/prebuilt/
*.o
*.a
*.so
*.dylib
*.dll
*.wasm.map

# --- Android (M3) ---
apps/android/.gradle/
apps/android/build/
apps/android/**/build/
apps/android/local.properties
*.apk
*.aab
*.keystore
*.jks

# --- iOS / Xcode (M4) ---
apps/ios/build/
apps/ios/**/xcuserdata/
apps/ios/**/*.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist
*.xcuserstate
DerivedData/
*.ipa
*.dSYM.zip

# --- Secrets: never committed, and unreadable by tooling. See .claude/settings.json ---
.env
.env.*
!.env.example
*.pem
*.p12
*.mobileprovision

# --- Editors and OS ---
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*~
.DS_Store
Thumbs.db
tests/conformance/native-outcomes.json

# Python bytecode. tools/*.py are run directly by CI and by developers, so the interpreter
# writes these beside them; one was committed in M1 PR 4c before this rule existed. An
# opaque binary artifact of a security-critical checker is the wrong thing to have in a
# repository whose whole engine story is about provenance.
__pycache__/
*.pyc
