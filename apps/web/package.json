{
  "name": "@burrow/web",
  "version": "0.0.0",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && tsc -p src/worker/tsconfig.json && tsc -p src/host/tsconfig.json",
