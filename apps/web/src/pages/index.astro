---
import BaseLayout from "../layouts/BaseLayout.astro";

// The five tools, each at its own indexable URL once it exists.
//
// `href` IS REQUIRED NOW, and that is the same rule stated differently. The old list allowed
// an entry without one and rendered it as plain text; the grid renders every entry as an <a>,
// where a missing href would be an unfocusable tile rather than visibly unlinked. So the type
// refuses the entry instead, and a tool that does not ship yet is not in this array at all.
//
// A `href` ONLY WHERE THE PAGE SHIPS. An early draft linked every name to `/{slug}` while no
// route existed, so every link was a 404 — on the one page whose whole argument is that it
// tells you the truth about itself. The rule that replaced it said each entry gains its link
// in the pull request that ships its page. Merge's page shipped and its link did not, so the
// rule was right and nobody applied it; both are linked here now.
//
// SPLIT'S HOLD IS LIFTED. It was unlinked because its outputs could carry data belonging to
// pages they excluded (ADR 0019 §2, issue #54) -- a tool whose whole claim is that your file
// does not leave your computer must not offer an operation that leaks part of it into a file
// you then send to somebody else. #54 closed that: the pruning policy takes back out what the
// engine's reachability closure drags in, `subset_closure.rs` asserts the structural property
// over every object in the source, and each part verifies its own output before it is posted
// (ADR 0022). `production-build.test.ts` now asserts the route SHIPS, which is the same check
// pointing the other way.
const tools = [
  {
    name: "Merge PDF",
    blurb: "Combine several PDFs into one, in the order you choose.",
    href: "/merge-pdf",
  },
  {
    name: "Split PDF",
    blurb: "Cut a PDF into separate files, at the pages you choose.",
    href: "/split-pdf",
  },
  {
    name: "Rotate PDF",
    blurb: "Turn pages that were scanned the wrong way up.",
    href: "/rotate-pdf",
  },
  {
    name: "Reorder PDF",
    blurb: "Move pages around without losing any of them.",
    href: "/reorder-pdf",
  },
  {
    name: "Compress PDF",
    // SAYS WHAT IT DOES, not what a person hopes. "Make a PDF smaller" is what every other
    // tool of this name promises and then delivers by re-encoding images at lower quality.
    // Spike 0005 measured burrow's answer at 85.6% on a form and 0.15% on a scan, so the
    // blurb names the mechanism instead -- somebody with a scan should be able to tell from
    // here that this is not the tool that will shrink it.
    blurb: "Store a PDF more efficiently, without re-encoding anything.",
    href: "/compress-pdf",
  },
] as { name: string; blurb: string; href: string }[];
---

<BaseLayout
  title="Not Only PDF — file tools that run on your own computer"
  description="Free, open-source file tools that run in your browser — PDF tools today. Your files are never uploaded, because there is no server to upload them to."
>
  <div class="read">
    <h1>Your files stay on this computer.</h1>

    <p class="claim">
      Not Only PDF is a set of file tools that run inside your browser. Nothing is uploaded, because
      there is no server to upload to.
    </p>
  </div>

  {
    /*
    THE TOOLS ARE THE PAGE. They used to be a definition list two thirds of the way down,
    under an essay and a diagram — on a phone you scrolled past about one and a third screens
    of prose before a single tool appeared. Somebody arriving from a search for "merge pdf"
    wants the tool, and the argument for why it is safe is what they read afterwards, not
    instead.

    The essay and the diagram were not cut. They are `/how-it-works`, linked below, which is
    the page that already existed inline.
  */
  }
  <nav class="tools" aria-label="Tools">
    {
      tools.map((tool) => (
        <a class="tool" href={tool.href}>
          <span class="tool__name">{tool.name}</span>
          <span class="tool__blurb">{tool.blurb}</span>
        </a>
      ))
    }
  </nav>

  <div class="read">
    <h2>Why this one</h2>

    {
      /*
      ONCE, PLAINLY, AND THE LAST ONE IS THE ONE THAT CANNOT BE COPIED. Any competitor can
      write "your files never leave your device" on a page that uploads them. Being able to
      read the code, and the reasoning behind it, is the only item here that a reader can
      check for themselves — so it is the one that carries the link.
    */
    }
    <ul class="why">
      <li>Nothing is uploaded. The file is read by code running on your own machine.</li>
      <li>No account, and nothing to sign up for.</li>
      <li>No waiting on an upload, and no queue — the work happens here.</li>
      <li>Free, with no paid tier and no commercial licence, ever.</li>
      <li>
        <strong>Open source</strong>, so the claim above is checkable rather than asserted: the <a
          href="https://github.com/TensorGreed/burrow">code is public</a
        >, and so is the reasoning behind it, including the decisions that turned out to be wrong.
      </li>
    </ul>

    <p>
      <a href="/how-it-works">How this works, and how you can check it</a> — what crosses the boundary,
      what does not, and how to watch for yourself in your browser's network tab.
    </p>

    <p class="unfinished">
      Not Only PDF is being built in the open and is not finished. Every tool listed above works
      today; a tool is only linked once its page ships. Redaction is still to come, and it is the
      one this project is most careful about.
    </p>
  </div>
</BaseLayout>

<style>
  /* Page-specific layout only. Everything else is `src/styles/base.css`. */

  /* The h1 is the privacy claim and it is the first thing on the page, so it is allowed to
     be large — but not so large that it costs the grid its place above the fold on a phone.
     It scales with the viewport rather than stepping at a breakpoint, because the thing
     being protected is a continuous quantity: how far down the first tool sits. */
  h1 {
    font-size: clamp(var(--step-2), 7vw, var(--step-4));
  }

  .claim {
    max-width: 44ch;
  }

  /* A grid of targets, not a list of links. Two columns on a phone, so all five tools are
     on screen at 390px without scrolling — checked by screenshot, which is the only way
     that claim is checkable. */
  .tools {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
    margin-block: var(--space-5) var(--space-7);
    max-width: var(--track-readout);
  }

  /* A surface you can act on, so `--edge` rather than `--rule`. NOT a card: one hairline,
     one 2px radius, no shadow, no lift on hover. See tokens.css. */
  .tool {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3);
    border: 1px solid var(--edge);
    border-radius: var(--radius);
    text-decoration: none;
  }

  .tool:hover .tool__name {
    text-decoration-thickness: 2px;
  }

  .tool__name {
    font-weight: var(--weight-strong);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .tool__blurb {
    color: var(--ink-quiet);
    font-size: var(--step--1);
    line-height: 1.35;
  }

  .why {
    margin: 0 0 var(--space-4);
    padding-inline-start: var(--space-5);
  }

  .why li {
    margin-block-end: var(--space-2);
  }

  .unfinished {
    color: var(--ink-quiet);
  }

  /* 34rem is where a fifth tile stops being cramped in three columns. Below it the grid
     stays two-up, which is what keeps all five above the fold on a phone. */
  @media (min-width: 34rem) {
    .tools {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-4);
    }

    .tool {
      padding: var(--space-4);
    }
  }
</style>
