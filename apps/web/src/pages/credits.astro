---
// The open-source credits page. THIS PAGE IS A LICENCE OBLIGATION, NOT A COURTESY.
//
// ADR 0008 and ADR 0010 admit three licences that impose affirmative notice obligations
// binding executable-only distribution -- which is what a wasm bundle is. All three say
// *documentation accompanying the distribution*, so a file in the repository does not
// discharge them for a website: the reader has to be able to get here. ADR 0008 names four
// surfaces; this is the second. The Android (M3) and iOS (M4) licence screens remain.
//
// A release that ships the engines without this page is a licence violation, not an
// oversight. See issue #16.
//
// FTL SECTION 3 -- READ BEFORE ADDING ANYTHING TO THIS PAGE OR THE SITE:
// the FreeType name must not be used to promote burrow. A "powered by FreeType" badge, a
// marketing line naming it, or a logo would violate that clause. Reproducing the required
// credit line here is not promotion; making it a selling point is.
//
// EVERY WORD OF THE NOTICES IS GENERATED, from engines/licenses.toml via
// tools/generate-credits.mjs, which runs as `prebuild`. Nothing on this page is typed out by
// hand, because a hand-written notice passes review once and then rots while the manifest
// moves on.
//
// WHAT THIS PAGE CARRIES IS SCOPED, and the rule changed when the scoping landed. It is every
// component distributed with `CREDITS.surfaces.web.artifacts` -- `qpdf-wasm`, what a browser
// actually downloads. Add a component to the manifest WITH that artifact and this page carries
// it on the next build; add one to another surface and this page deliberately does not, and
// src/credits.test.ts asserts both directions. The header used to say the page carried every
// component in the manifest, which after the scoping described the opposite of what the code
// does -- on a page whose whole justification is a licence obligation, which is the worst place
// for a comment somebody might act on.
//
// Note the FreeType wording. FTL section 2 literally says "based in part OF the work" -- not
// "on". That is upstream's text, reproduced verbatim rather than corrected, which is what a
// verbatim notice obligation means.
import BaseLayout from "../layouts/BaseLayout.astro";
import { CREDITS } from "../generated/credits.js";

// SCOPED TO WHAT THIS BROWSER DOWNLOADS. `CREDITS.components` is every component in the
// manifest, across every artifact burrow ships anywhere; `CREDITS.surfaces.web` names the
// subset distributed with the files a web reader actually receives.
//
// It was the whole manifest until this change, and until spike 0004 that was the same list.
// PDFium left the web payload and the page went on crediting FreeType, HarfBuzz, ICU, lcms,
// OpenJPEG, Abseil and eight more to a reader whose download contains none of them. Over-
// declaring breaches nothing, which is why a security review raised it as a note rather than
// a finding -- but it cost the sentence below, that this page cannot fall behind what we
// actually ship. That was true in one direction and loose in the other, and a notice page
// crediting things you did not receive is a page you cannot check.
//
// THE OTHER SURFACES ARE NOT LOSING ANYTHING. FreeType's FTL §2 and HarfBuzz's
// MIT-Modern-Variant are still owed by the artifacts that carry PDFium; the Android (M3) and
// iOS (M4) screens scope to their own artifacts from the same generated data. Nothing was
// dropped from the DATA, only from this view of it.
const scope = CREDITS.surfaces.web;
const shipped = CREDITS.components.filter((c) => scope.components.includes(c.name));

// COMPONENTS THAT ARRIVE ONLY WITH THE RENDER BUNDLE (ADR 0026). Derived in
// `generate-credits.mjs` from the artifact sets rather than listed here, so a component that
// starts shipping in both stops being described as conditional without anyone noticing.
const conditional = shipped.filter((c) => scope.conditional.components.includes(c.name));
const conditionalNames = conditional.map((c) => c.name).join(", ");

const notices = shipped.filter((c) => c.noticeRequired !== null);
const withText = shipped.filter((c) => c.licenseText !== null);

/** A stable id for a component, so the roster can link into the licence texts below. */
const slug = (name: string) =>
  name
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");
---

<BaseLayout
  title="Credits and open-source licences — Not Only PDF"
  description="The open-source components Not Only PDF is built from, their licences, and the notices those licences require."
>
  <h1>Credits and open-source licences</h1>

  <p>
    Not Only PDF is free and open source under <code>MIT OR Apache-2.0</code>. It is built on other
    people's work, and the notices below are required by the licences that work is under — not
    supplied as a courtesy.
  </p>

  <p>
    This page is generated at build time from the same licence manifest our CI licence check reads,
    so it cannot fall behind what we actually ship. Audit of record:
    <strong>{CREDITS.lastAudited}</strong>.
  </p>

  <p>
    <strong>This page credits what your browser can download</strong> — the PDF engines that run in this
    tab, and the components inside them. Not Only PDF's Android and iOS apps and its command-line builds
    carry more than this, and each of those credits its own. If you are comparing this list against the
    project's licence manifest, that is why it is shorter: the manifest covers every build, and this page
    covers the web.
  </p>

  <p>
    <strong>Some of it arrives only if you look at page pictures.</strong> Most tools here need one PDF
    engine; showing you a picture of a page needs a second one, and your browser fetches it the first
    time a page asks for one. So this list is deliberately longer than what you have necessarily received:
    {conditional.length} of the {shipped.length} components below — {conditionalNames} — come with that
    second engine, and if you have only merged or split a file you do not have them.
  </p>

  <p>
    It is listed this way round on purpose. A page that credited only the first engine would owe you
    these notices the moment you looked at a page picture, and it cannot know in advance whether you
    will. Crediting more than you downloaded breaks no licence; crediting less would.
  </p>

  <h2 id="required-notices">Required notices</h2>

  <p>
    {
      notices.length === 1
        ? "One component imposes a notice obligation"
        : `${notices.length} components impose notice obligations`
    }
    that bind{notices.length === 1 ? "s" : ""} distribution of compiled code. {
      notices.length === 1 ? "It is" : "These are"
    } reproduced verbatim.
  </p>

  {
    notices.map((component) => (
      <section>
        <h3>
          {component.name}
          {component.version ? ` ${component.version}` : ""}
        </h3>
        <p>
          <code>{component.license}</code> — {component.noticeRequired}
        </p>
        <blockquote>
          <pre>{component.licenseText}</pre>
        </blockquote>
      </section>
    ))
  }

  <h2 id="components">Every component in this download</h2>

  <p>
    {shipped.length} components ship inside the engine this page's tools run on.
    <em>Linked</em> means its code was confirmed present in a shipped binary by symbol inspection; a component
    that is not linked still travels in the package we distribute.
  </p>

  <table>
    <thead>
      <tr>
        <th scope="col">Component</th>
        <th scope="col">Version</th>
        <th scope="col">Licence</th>
        <th scope="col">Linked</th>
      </tr>
    </thead>
    <tbody>
      {
        shipped.map((component) => (
          /*
            `data-component` carries the component's exact name as an attribute so a test can
            assert the ROSTER rather than search the document. Matching a bare name against
            this page does not work: it is 170 KB of other people's licence text, and
            `"icu"` is a substring of "PARTICULAR", which appears in every BSD disclaimer
            here. A completeness check written that way passes with ICU missing entirely --
            measured, not hypothesised. Do not remove this attribute.
          */
          <tr data-component={component.name}>
            <th scope="row">
              {component.licenseText ? (
                <a href={`#licence-${slug(component.name)}`}>{component.name}</a>
              ) : (
                component.name
              )}
            </th>
            <td>{component.version ?? "—"}</td>
            <td>
              <code>{component.license}</code>
            </td>
            <td>{component.linked ? "yes" : "no"}</td>
          </tr>
        ))
      }
    </tbody>
  </table>

  <h2 id="licence-texts">Full licence texts</h2>

  {
    withText.map((component) => (
      <section id={`licence-${slug(component.name)}`}>
        <h3>
          {component.name}
          {component.version ? ` ${component.version}` : ""}
        </h3>
        <p>
          <code>{component.license}</code>
        </p>
        <pre>{component.licenseText}</pre>
      </section>
    ))
  }

  <h2 id="the-project">Not Only PDF itself</h2>

  <p>
    Not Only PDF is licensed under either of <code>Apache-2.0</code> or <code>MIT</code>, at your
    option. Unless you explicitly state otherwise, any contribution intentionally submitted for
    inclusion in Not Only PDF shall be dual licensed as above, without any additional terms or
    conditions.
  </p>

  <p>
    Source: <a href="https://github.com/TensorGreed/burrow">github.com/TensorGreed/burrow</a>. The
    machine-readable manifest behind this page is <code>engines/licenses.toml</code>, and the full
    repository notices are in <code>THIRD_PARTY_NOTICES.md</code>.
  </p>
</BaseLayout>

<style>
  /* Licence texts are fixed-width originals; let them wrap rather than scroll the page. */
  pre {
    white-space: pre-wrap;
    word-wrap: break-word;
    font-size: 0.8rem;
    line-height: 1.5;
    overflow-x: auto;
  }

  table {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.9rem;
  }

  th,
  td {
    border-bottom: 1px solid currentColor;
    padding: 0.3rem 0.5rem;
    text-align: left;
    vertical-align: top;
  }

  blockquote {
    margin-inline: 0;
    padding-inline-start: 1rem;
    border-inline-start: 3px solid currentColor;
  }

  section {
    margin-block: 2rem;
  }
</style>
