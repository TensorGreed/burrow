# Every third-party download used by this spike, pinned by version AND sha256.
# Nothing is fetched from an unpinned URL, and nothing is used before its checksum
# is verified. Checksums are filled in by fetch-engines.sh on first run and must then
# be committed, so a later fetch that returns different bytes fails loudly.

# pdfium-binaries, WebAssembly package. Upstream marks the wasm build EXPERIMENTAL:
# https://github.com/bblanchon/pdfium-binaries/issues/28
PDFIUM_TAG="chromium/8044"
PDFIUM_WASM_URL="https://github.com/bblanchon/pdfium-binaries/releases/download/chromium%2F8044/pdfium-wasm.tgz"
PDFIUM_WASM_SHA256="2528dfb9762a5325f141fa29868257da51dd05952b13e2c02a08d4de00711fe1"

# qpdf source. No prebuilt wasm exists, so we build it. 12.4.1 is the latest release.
QPDF_VERSION="12.4.1"
QPDF_URL="https://github.com/qpdf/qpdf/releases/download/v12.4.1/qpdf-12.4.1.tar.gz"
QPDF_SHA256="f045aa277be2356ff53a89a8622945958291177d2483afc20ede7c8a8cd3873c"

# Emscripten SDK. pdfium-binaries pins 3.1.72 for its own wasm build; we use current
# 6.0.9 because Rust 1.98's wasm32-unknown-emscripten target expects a recent one, and
# because there is no wasm .a from pdfium to be ABI-compatible with anyway.
EMSDK_VERSION="6.0.9"
