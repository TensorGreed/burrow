# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.{rs,toml}]
indent_size = 4

[*.{js,mjs,cjs,ts,mts,tsx,jsx,svelte,astro,json,jsonc,css,scss,html,yml,yaml}]
indent_size = 2

[*.{kt,kts,gradle}]
indent_size = 4

[*.swift]
indent_size = 4

[*.{md,markdown}]
# Trailing whitespace is a line break in Markdown.
trim_trailing_whitespace = false

[*.{sh,bash}]
indent_size = 2

[Makefile]
indent_style = tab

[LICENSE-*]
insert_final_newline = false
trim_trailing_whitespace = false
